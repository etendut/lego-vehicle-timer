{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Compile PyBricks files",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/compile_pybricks_files.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Generate grid images",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/generate_grid_images.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
